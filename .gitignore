kazvks/config.php

# Опрос пулов DHCP: адрес оборудования, учётная запись и путь к ключу
config/ssh_pool.php

# Артефакты обновления: копии перед установкой, собранные пакеты,
# развёрнутые старые версии. Помимо веса это ещё и утечка: при
# обновлении в копию попадает kazvks/config.php, который сам по себе
# в репозиторий не пускают, а внутри backups/ ничто не останавливало
backups/
packages/
preview/

# Служебная учётка для опроса оборудования по SSH
config/ssh.php

# Рабочие файлы заглушки МФУ (tools/escl_mock.php): состояние задания
